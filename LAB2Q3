#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int n;
    printf("Enter n: ");
    scanf("%d", &n);

    if (fork() == 0) {
        long long a = 0, b = 1, next;
        printf("Fibonacci series: ");
        for (int i = 1; i <= n; i++) {
            printf("%lld ", a);
            next = a + b;
            a = b;
            b = next;
        }
        printf("\n");
    } else {
        wait(NULL);
        printf("Armstrong numbers: ");
        for (int i = 1; i <= n; i++) {
            int temp = i, digits = 0, sum = 0;
            while (temp > 0) {
                digits++;
                temp /= 10;
            }
            temp = i;
            while (temp > 0) {
                int d = temp % 10;
                int p = 1;
                for (int k = 0; k < digits; k++) p *= d;
                sum += p;
                temp /= 10;
            }
            if (sum == i) printf("%d ", i);
        }
        printf("\n");
    }
    return 0;
}
