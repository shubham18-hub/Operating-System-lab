#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int n, i, j, isPrime;
    long long a = 0, b = 1, next;

    printf("Enter n: ");
    scanf("%d", &n);

    if (fork() == 0) {
        // Child Process: Fibonacci series up to n
        printf("[Child] Fibonacci series up to %d terms: ", n);
        for (i = 1; i <= n; i++) {
            printf("%lld ", a);
            next = a + b;
            a = b;
            b = next;
        }
        printf("\n");
    } 
    else {
        // Parent Process: Prime numbers up to n
        wait(NULL); // Wait for child process to finish printing first

        printf("[Parent] Prime numbers up to %d: ", n);
        for (i = 2; i <= n; i++) {
            isPrime = 1;
            for (j = 2; j * j <= i; j++) {
                if (i % j == 0) {
                    isPrime = 0;
                    break;
                }
            }
            if (isPrime) {
                printf("%d ", i);
            }
        }
        printf("\n");
    }

    return 0;
}
